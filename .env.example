PORT=3000
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_DELIVERIES_RANGE=ENTREGAS!A:E
GOOGLE_SHEETS_PICKUPS_RANGE=COLETAS!A:D
# Caminho do JSON da service account (opcional se usar credenciais inline)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# Alternativa ao arquivo: credenciais em JSON puro
GOOGLE_SERVICE_ACCOUNT_JSON=
# Intervalo de atualização em ms (padrão 60s)
REFRESH_INTERVAL_MS=60000
# Usuário/senha para autenticação simples no front (opcional)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=123456
